<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Vintage Story 1.22 runs on .NET 10. -->
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>VintageStoryHDR</AssemblyName>
    <RootNamespace>VintageStoryHDR</RootNamespace>
    <RequiresVintageStory>true</RequiresVintageStory>
    <!-- Game assemblies are provided by the game at runtime. -->
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <!-- The DXGI / D3D11 / WGL interop calls COM vtables and driver entry points directly. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>0.2.1</Version>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="VintagestoryAPI">
      <HintPath>$(VintageStoryPath)/VintagestoryAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!--
      The patches name game-internal types (ClientPlatformWindows, ShaderRegistry) in
      their signatures. Everything they touch is listed in Platform/HdrPatchTargets.cs
      and verified before any patch is applied, so a game update that moves these members
      leaves vanilla presentation alone instead of failing at run time.
    -->
    <Reference Include="VintagestoryLib">
      <HintPath>$(VintageStoryPath)/VintagestoryLib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(VintageStoryPath)/Lib/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="OpenTK.Core">
      <HintPath>$(VintageStoryPath)/Lib/OpenTK.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="OpenTK.Graphics">
      <HintPath>$(VintageStoryPath)/Lib/OpenTK.Graphics.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="OpenTK.Mathematics">
      <HintPath>$(VintageStoryPath)/Lib/OpenTK.Mathematics.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="OpenTK.Windowing.Common">
      <HintPath>$(VintageStoryPath)/Lib/OpenTK.Windowing.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="OpenTK.Windowing.Desktop">
      <HintPath>$(VintageStoryPath)/Lib/OpenTK.Windowing.Desktop.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="OpenTK.Windowing.GraphicsLibraryFramework">
      <HintPath>$(VintageStoryPath)/Lib/OpenTK.Windowing.GraphicsLibraryFramework.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(VintageStoryPath)/Lib/Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Include="modinfo.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="modicon.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Assembles the installable mod folder under bin/<Configuration>/mod/. -->
  <Target Name="VshdrAssembleModFolder" AfterTargets="Build">
    <PropertyGroup>
      <ModFolder>$(OutDir)mod/</ModFolder>
    </PropertyGroup>
    <Copy SourceFiles="$(OutDir)$(AssemblyName).dll" DestinationFolder="$(ModFolder)" />
    <Copy SourceFiles="modinfo.json;modicon.png" DestinationFolder="$(ModFolder)" />
  </Target>

</Project>
